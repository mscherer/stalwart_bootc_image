# see https://docs.openstack.org/nova/latest/user/metadata.html#metadata-openstack-format
dmi:*:svnOpenStackFoundation:*
 IMDS_VENDOR=openstack
 IMDS_DATA_URL=http://169.254.169.254
 IMDS_ADDRESS_IPV4=169.254.169.254
 IMDS_KEY_HOSTNAME=/1.0/meta-data/hostname
 IMDS_KEY_IPV4_PUBLIC=/1.0/meta-data/local-ipv4
 IMDS_KEY_SSH_KEY=/1.0/meta-data/public-keys/0/openssh-key
 IMDS_KEY_USERDATA=/openstack/latest/user_data

