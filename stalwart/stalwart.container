[Unit]
Description=Stalwart container
After=local-fs.target

[Service]
StateDirectory=stalwart
# do not use those, as it doesn't seems to start with a error message 'cannot stat /.config' (likely podman
# cf https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# "Note that Quadlet units do not support running as a non-root user by defining the User, Group, or DynamicUser systemd options."
#DynamicUser=yes
#User=stalwart

# hardening to test
# break netavark: set sysctl net/ipv4/conf/eth0/arp_notify: IO error: Read-only file system (os error 30)
#ProtectKernelTunables=true
# not sure if that's so useful
#SystemCallArchitectures=native
# avoid attack on various file in /dev
#DevicePolicy=closed
# avoid loading modules
#ProtectKernelModules=true
# prevent pointer leaks
#ProtectKernelLogs=true
# just as a precaution
#ProtectProc=invisible
# netavark requires AF_NETLINK
# systemd/journald use AF_UNIX
#RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK


[Container]
Image=ghcr.io/mscherer/stalwart-custom:latest
AutoUpdate=registry

#
# Note: keep the firewall in the nftables up to date
#
# SMTP
PublishPort=25:25   
# SMTPS
PublishPort=465:465
# submission
PublishPort=4587:4587
# http
PublishPort=127.0.0.1:8080:8080
# https
#PublishPort=443:443
# imap
PublishPort=143:143
# imaps
PublishPort=993:993
# sieve
PublishPort=127.0.0.1:4190:4190
# pop3
#PublishPort=110:110
# pop3s
#PublishPort=995:995

PodmanArgs=--uts=host

# used for recovery and bootstrap
EnvironmentFile=/run/stalwart-recovery.env

Volume=/var/lib/stalwart:/var/lib/stalwart:Z,U
Volume=/usr/local/etc/config.json:/etc/stalwart/config.json:ro
# using ro do not seems to make the directories readable for some reasons, so overlay work
# I am sure there is a better way
Volume=/etc/pki:/etc/pki:O
Volume=/etc/ssl:/etc/ssl:O

# for logging purpose
Volume=/var/log/stalwart:/var/log/stalwart:Z,U
Volume=/dev/log:/dev/log
Volume=/run/systemd/journal/socket:/run/systemd/journal/socket

# needed to download web apps
Tmpfs=/tmp

# hardening
ReadOnly=true
NoNewPrivileges=true

AddCapability=CAP_NET_BIND_SERVICE
DropCapability=ALL

[Install]
# Start by default on boot
WantedBy=multi-user.target default.target
